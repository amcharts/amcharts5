{
  "name": "@amcharts/amcharts5-react-native",
  "version": "5.0.0",
  "libraryVersion": "5.21.4",
  "description": "A React Native component for amCharts 5: charts from a JSON config or from chart code, drawn in a WebView",
  "author": "amCharts <contact@amcharts.com> (https://www.amcharts.com/)",
  "homepage": "https://github.com/amcharts/amcharts5/tree/master/integrations/react-native#readme",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/amcharts/amcharts5/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amcharts/amcharts5.git",
    "directory": "integrations/react-native"
  },
  "keywords": [
    "amcharts",
    "amcharts5",
    "react-native",
    "expo",
    "charts",
    "chart",
    "data-visualization",
    "maps"
  ],
  "main": "dist/index.js",
  "react-native": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/generate.cjs && tsc -p .",
    "prepack": "npm run build && node -e \"require('fs').copyFileSync('../../packages/shared/LICENSE', 'LICENSE')\""
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-webview": ">=13"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "react-native-webview": "^14.0.1",
    "typescript": "^5.9.3"
  }
}
