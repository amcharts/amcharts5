{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2018"],
    "types": [],
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "dist",
