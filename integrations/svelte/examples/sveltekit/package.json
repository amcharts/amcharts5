{
	"name": "amcharts5-svelte-sveltekit-example",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''"
	},
	"dependencies": {
		"@amcharts/amcharts5": "^5.21.4",
		"@amcharts/amcharts5-svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
