{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2018", "DOM"],
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@amcharts/amcharts5": ["../../dist/es2015/index.d.ts"],
      "@amcharts/amcharts5/*": ["../../dist/es2015/*"]
    }
  },
  "include": ["src"]
}
