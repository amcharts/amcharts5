{
  "type": "MapChart",
  "settings": {
    "panX": "rotateX",
    "panY": "rotateY",
    "animations": [
      { "key": "rotationX", "from": 0, "to": 360, "duration": 120000, "loops": 0 }
    ],
    "autoAppear": true,
    "appearDuration": 1000,
    "appearDelay": 100,
    "projectionName": "geoOrthographic"
  },
  "properties": {
    "series": ["#series-0", "#series-1"]
  },
  "children": [
    {
      "type": "Label",
      "settings": {
        "text": "Imagery: NASA Earth Observatory",
        "fontSize": 12,
        "x": { "type": "Percent", "value": 100 },
        "centerX": { "type": "Percent", "value": 100 },
        "y": { "type": "Percent", "value": 100 },
        "centerY": { "type": "Percent", "value": 100 }
      }
    }
  ],
  "refs": [
    {
      "data-0": []
    },
    {
      "data-1": []
    },
    {
      "series-0": {
        "type": "MapRasterSeries",
        "settings": { "src": "https://cdn.amcharts.com/lib/5/geodata/images/earthDay2048.jpg" }
      }
    },
    {
      "series-1": {
        "type": "MapPolygonSeries",
        "settings": { "geoJSON": "am5geodata_worldLow" },
        "properties": {
          "mapPolygons": {
            "properties": {
              "template": {
                "settings": {
                  "fillOpacity": 0,
                  "stroke": { "type": "Color", "value": "#ffffff" },
                  "strokeWidth": 0.5,
                  "strokeOpacity": 0.6
                }
              }
            }
          }
        }
      }
    }
  ]
}
