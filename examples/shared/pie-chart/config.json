{
  "type": "PieChart",
  "settings": {
    "layout": { "type": "VerticalLayout" },
    "focusable": true,
    "ariaLabel": "Pie chart of seven categories, One to Seven, and their share of the total. Tab to the slices, then move between them with the up and down arrow keys; Enter pulls a slice out"
  },
  "properties": {
    "series": ["#series-0"]
  },
  "children": [
    {
      "type": "Legend",
      "settings": {
        "centerX": { "type": "Percent", "value": 50 },
        "x": { "type": "Percent", "value": 50 },
        "marginTop": 15,
        "marginBottom": 15
      },
      "properties": {
        "data": "#series-0.dataItems",
        "itemContainers": {
          "properties": {
            "template": {
              "settings": { "focusableGroup": "legend", "tabindexOrder": 10 }
            }
          }
        }
      }
    }
  ],
  "refs": [
    {
      "data-0": [
        { "value": 10, "category": "One" },
        { "value": 9, "category": "Two" },
        { "value": 6, "category": "Three" },
        { "value": 5, "category": "Four" },
        { "value": 4, "category": "Five" },
        { "value": 3, "category": "Six" },
        { "value": 1, "category": "Seven" }
      ]
    },
    {
      "series-0": {
        "type": "PieSeries",
        "settings": {
          "valueField": "value",
          "categoryField": "category",
          "autoAppear": true,
          "appearDuration": 1000,
          "appearDelay": 100
        },
        "properties": {
          "data": "#data-0",
          "slices": {
            "properties": {
              "template": {
                "settings": {
                  "focusable": true,
                  "focusableGroup": "slices",
                  "hoverOnFocus": true,
                  "ariaLabel": "{category}: {value}, {valuePercentTotal.formatNumber('0.0')}%"
                }
              }
            }
          }
        }
      }
    }
  ]
}
