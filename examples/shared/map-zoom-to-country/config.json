{
  "type": "MapChart",
  "settings": {
    "panX": "translateX",
    "panY": "translateY",
    "zoomControl": {
      "type": "ZoomControl",
      "properties": {
        "homeButton": {
          "settings": { "visible": true }
        }
      }
    },
    "focusable": true,
    "ariaLabel": "World map of countries that zooms to the one you pick. Tab to the countries, move between them with the up and down arrow keys, and press Enter to zoom to one or back out",
    "autoAppear": true,
    "appearDuration": 1000,
    "appearDelay": 100,
    "projectionName": "geoMercator"
  },
  "properties": {
    "series": ["#series-0"]
  },
  "refs": [
    {
      "data-0": []
    },
    {
      "series-0": {
        "type": "MapPolygonSeries",
        "settings": {
          "geoJSON": "am5geodata_worldLow",
          "exclude": ["AQ"],
          "clickZoom": true
        },
        "properties": {
          "mapPolygons": {
            "properties": {
              "template": {
                "settings": {
                  "tooltipText": "{name}",
                  "interactive": true,
                  "focusable": true,
                  "focusableGroup": "countries",
                  "hoverOnFocus": true,
                  "ariaLabel": "{name}"
                },
                "states": [
                  {
                    "key": "hover",
                    "settings": { "fill": "@root.interfaceColors.get('primaryButtonHover')" }
                  },
                  {
                    "key": "active",
                    "settings": { "fill": "@root.interfaceColors.get('primaryButtonActive')" }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
