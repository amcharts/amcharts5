    {
      "axis-0": {
        "type": "ValueAxis",
        "settings": {
          "logarithmic": true,
          "maxDeviation": 1,
          "renderer": {
            "type": "AxisRendererX",
            "settings": { "pan": "zoom" }
          },
          "tooltip": { "type": "Tooltip" }
        },
        "children": [
          {
            "type": "Label",
            "settings": {
              "text": "GDP per capita, USD",
