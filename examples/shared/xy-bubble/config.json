            }
          }
        ]
      }
    },
    {
      "axis-1": {
        "type": "ValueAxis",
        "settings": {
          "maxDeviation": 1,
          "renderer": {
            "type": "AxisRendererY",
            "settings": { "pan": "zoom" }
          },
          "tooltip": { "type": "Tooltip" }
        },
        "children": [
          {
            "type": "Label",
            "settings": {
              "rotation": -90,
              "text": "Life expectancy, years",
              "y": { "type": "Percent", "value": 50 },
              "centerX": { "type": "Percent", "value": 50 }
            },
            "index": 0
          }
        ]
      }
    },
    {
      "series-0": {
        "type": "LineSeries",
        "settings": {
          "calculateAggregates": true,
          "xAxis": "#axis-0",
          "yAxis": "#axis-1",
          "valueXField": "gdp",
          "valueYField": "lifeExpectancy",
          "valueField": "population",
          "seriesTooltipTarget": "bullet",
          "tooltip": {
            "type": "Tooltip",
            "settings": {
              "pointerOrientation": "horizontal",
              "labelText": "[bold]{country}[/]\nLife expectancy: {valueY.formatNumber('#.0')}\nGDP: {valueX.formatNumber('#,###.')}\nPopulation: {value.formatNumber('#,###.')}"
            }
          },
          "autoAppear": true,
          "appearDuration": 1000,
          "heatRules": [
            {
              "target": "#template-0",
              "min": 3,
              "max": 60,
              "dataField": "value",
              "key": "radius",
              "__parse": true
            }
          ]
        },
        "properties": {
          "data": "#data-0",
          "strokes": {
            "properties": {
              "template": {
                "settings": { "visible": false }
              }
            }
          },
          "bullets": [
            {
              "type": "Bullet",
              "settings": {
                "sprite": {
                  "type": "Circle",
                  "settings": { "radius": 5, "fillOpacity": 0.8, "templateField": "bulletSettings" },
                  "properties": { "template": "#template-0" }
                }
              }
            }
          ]
        }
      }
    }
